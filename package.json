{
  "name": "0then0-catalog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:dist": "node scripts/check-dist.ts",
    "check:links": "node scripts/check-external-links.ts",
    "releases:update": "node scripts/update-releases.ts",
    "serve:dist": "node scripts/serve-dist.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:dist && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
